---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import katexCss from 'katex/dist/katex.min.css?url';
import BaseLayout from './BaseLayout.astro';
import Avatar from '@/components/Avatar.astro';
import ContourArt from '@/components/ContourArt.astro';
import Emph from '@/components/Emph.astro';
import Icon from '@/components/Icon.astro';
import PostEnd from '@/components/PostEnd.astro';
import PostList from '@/components/PostList.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { SITE } from '@/config';
import { formatDate, metaDate, postUrl, readingTime, tagUrl, wordCount, type Post } from '@/lib/posts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  hasMath: boolean;
  prev?: Post | undefined;
  next?: Post | undefined;
  related: Post[];
}

const { post, headings, hasMath, prev, next, related } = Astro.props;
const { title, displayTitle, description, pubDate, updatedDate, tags, cover, coverAlt, draft } = post.data;
const minutes = readingTime(post.body);
const words = wordCount(post.body);
const ogImage = `/og/blog/${post.id}.png`;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  image: new URL(ogImage, SITE.url).href,
  url: new URL(postUrl(post), SITE.url).href,
  mainEntityOfPage: new URL(postUrl(post), SITE.url).href,
  keywords: tags.join(', '),
  wordCount: words,
};
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  imageAlt={title}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
  jsonLd={articleLd}
>
  <Fragment slot="head">{hasMath && <link rel="stylesheet" href={katexCss} />}</Fragment>

  <div class="progress" aria-hidden="true"><div class="progress-bar" data-progress></div></div>

  <article class="post container-page pt-10 sm:pt-14" data-pagefind-body data-pagefind-meta={`date:${metaDate(pubDate)}, type:Post`}>
    <header class="post-header" id="top">
      <a href="/blog/" class="group mb-8 inline-flex items-center gap-1.5 text-sm text-fg-muted hover:text-fg" data-pagefind-ignore>
        <Icon name="arrow-left" size={16} class="transition-transform duration-300 group-hover:-translate-x-0.5" />
        All posts
      </a>
      {
        (tags.length > 0 || draft) && (
          <p class="kicker" data-pagefind-ignore>
            {tags.map((tag, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={tagUrl(tag)}>{tag}</a>
              </>
            ))}
            {draft && <span class="ml-2 rounded-full bg-accent-soft px-2 py-0.5 text-accent">Draft</span>}
          </p>
        )
      }
      <h1 class="post-title" transition:name={`post-title-${post.id}`}>
        <Emph text={displayTitle} />
      </h1>
      <p class="dek">{description}</p>
      <div class="byline" data-pagefind-ignore>
        <Avatar size={36} />
        <div class="min-w-0 leading-tight">
          <a href="/about/" class="font-medium hover:text-accent">{SITE.name}</a>
          <p class="mt-1 font-mono text-xs text-fg-subtle">
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate, 'long')}</time>
            {updatedDate && (
              <>
                {' · updated '}
                <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </>
            )}
            {` · ${minutes} min read · ${words.toLocaleString('en-US')} words`}
          </p>
        </div>
      </div>
    </header>

    <div class="banner" transition:name={`post-visual-${post.id}`} data-pagefind-ignore>
      {
        cover ? (
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 80rem) 72rem, 100vw"
            class="size-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <ContourArt seed={post.id} />
        )
      }
    </div>

    <aside class="post-toc" data-pagefind-ignore>
      <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
        <TableOfContents headings={headings} minutes={minutes} />
      </div>
    </aside>

    <div
      class="article prose post-body"
      data-search-type="Post"
      data-search-title={title}
      data-search-description={description}
      data-search-date={metaDate(pubDate)}
    >
      <slot />
    </div>

    <div class="post-margin" aria-hidden="true" data-pagefind-ignore data-sidenotes></div>

    <div class="post-after" data-pagefind-ignore>
      <PostEnd post={post} prev={prev} next={next} />
      {
        related.length > 0 && (
          <section class="mt-16" aria-labelledby="related-heading">
            <h2 id="related-heading" class="mb-6 text-xl font-semibold">Related posts</h2>
            <PostList posts={related} />
          </section>
        )
      }
    </div>
  </article>

  <dialog class="lightbox" data-lightbox aria-label="Image viewer">
    <img alt="" data-lightbox-img />
    <p class="lightbox-caption" data-lightbox-caption></p>
    <button type="button" class="icon-btn lightbox-close" aria-label="Close image" data-lightbox-close>
      <Icon name="x" />
    </button>
  </dialog>
  <p class="toast" role="status" aria-live="polite" data-toast></p>
</BaseLayout>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 2px;
    pointer-events: none;
  }
  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* Layout: one column on small screens; TOC rail + article from lg; plus a margin column for
     sidenotes and wide figures from xl. */
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'header' 'banner' 'toc' 'body' 'after';
    column-gap: 3.5rem;
  }
  .post-header {
    grid-area: header;
  }
  .banner {
    grid-area: banner;
  }
  .post-toc {
    grid-area: toc;
    margin-top: 2rem;
  }
  .post-body {
    grid-area: body;
    margin-top: 1.5rem;
  }
  .post-margin {
    display: none;
  }
  .post-after {
    grid-area: after;
  }
  @media (width >= 64rem) {
    .post {
      grid-template-columns: 12rem minmax(0, 1fr);
      grid-template-areas: '. header' '. banner' 'toc body' '. after';
    }
    .post-toc,
    .post-body {
      margin-top: 3.5rem;
    }
  }
  @media (width >= 80rem) {
    .post {
      grid-template-columns: 12rem minmax(0, 43rem) minmax(13rem, 1fr);
      grid-template-areas: '. header header' '. banner banner' 'toc body margin' '. after .';
    }
    .post-margin {
      display: block;
      grid-area: margin;
      position: relative;
      margin-top: 3.5rem;
    }
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .kicker a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .post-title {
    width: fit-content;
    max-width: 22ch;
    margin-top: 1rem;
    font-size: clamp(2.4rem, 5.5vw, 4.25rem);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .dek {
    max-width: 40rem;
    margin-top: 1.25rem;
    color: var(--fg-muted);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.6;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
  }
  .banner {
    margin-top: 2.5rem;
    aspect-ratio: 16 / 6;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background: var(--bg-subtle);
  }
  @media (width < 40rem) {
    .banner {
      aspect-ratio: 16 / 8;
    }
  }
</style>

<script>
  import { initPost } from '@/lib/post-reading';

  let cleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = document.querySelector('.post') ? initPost() : undefined;
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
