---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroField from '@/components/HeroField.astro';
import Icon from '@/components/Icon.astro';
import PostList from '@/components/PostList.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { SITE, SOCIALS } from '@/config';
import { getPosts, getProjects } from '@/lib/posts';

const posts = (await getPosts()).slice(0, 4);
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 4);

// Split the headline into words so each one can slide up. *Starred* phrases use the serif and
// stay together on one line.
const tokens = SITE.headline
  .split('*')
  .flatMap((segment, i) =>
    i % 2 === 1
      ? [{ text: segment, highlight: true }]
      : segment.split(/(\s+)/).map((text) => ({ text, highlight: false })),
  )
  .filter((token) => token.text);
let wordIndex = 0;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: 'M.Sc. Artificial Intelligence student',
  alumniOf: 'Shiraz University of Technology',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'University of Freiburg' },
  sameAs: SOCIALS.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};
---

<BaseLayout jsonLd={personLd}>
  <section class="hero relative isolate -mt-(--header-h) flex min-h-[min(100svh,56rem)] items-center">
    <HeroField />
    <div class="container-page relative pt-(--header-h) pb-16">
      <div class="max-w-4xl pt-10 sm:pt-0">
        {
          SITE.availability && (
            <p class="hero-in inline-flex items-center gap-2 rounded-full border border-border bg-surface/60 px-3 py-1 text-xs font-medium text-fg-muted backdrop-blur" style="--d: 0">
              <span class="relative flex size-2">
                <span class="ping absolute inline-flex size-full rounded-full bg-[var(--tip)]" />
                <span class="relative inline-flex size-2 rounded-full bg-[var(--tip)]" />
              </span>
              {SITE.availability}
            </p>
          )
        }
        <p class="hero-in mt-7 font-mono text-[0.8125rem] text-fg-muted" style="--d: 1">
          {SITE.name} <span class="text-fg-subtle">/</span> {SITE.eyebrow}
        </p>
        <h1 class="mt-4 text-[2.75rem] leading-[1.02] font-semibold tracking-[-0.02em] sm:text-7xl lg:text-[4.75rem]">
          {
            tokens.map(({ text, highlight }) =>
              /^\s+$/.test(text) ? (
                ' '
              ) : (
                <span class="word-mask">
                  <span class:list={['word', { 'serif text-gradient whitespace-nowrap': highlight }]} style={`--w: ${wordIndex++}`}>
                    {text}
                  </span>
                </span>
              ),
            )
          }
        </h1>
        <p class="hero-in mt-8 max-w-xl text-lg leading-relaxed text-fg-muted sm:text-xl" style="--d: 4">
          {SITE.intro}
        </p>
        <div class="hero-in mt-10 flex flex-wrap gap-3" style="--d: 5">
          <a href="/blog/" class="btn btn-primary">
            Read the blog <Icon name="arrow-right" size={16} data-slide />
          </a>
          <a href="/projects/" class="btn btn-ghost">View projects</a>
          <a href={SITE.cv} class="btn btn-ghost" download>
            <Icon name="download" size={16} /> Download CV
          </a>
        </div>
      </div>
    </div>
    <div class="pointer-events-none absolute inset-x-0 bottom-6">
      <div class="container-page flex items-end justify-between gap-6">
        {
          SITE.now.text ? (
            <a href={SITE.now.href} class="now hero-in pointer-events-auto group" style="--d: 7">
              <span class="now-label">Now</span>
              <span class="link-underline text-fg-muted group-hover:text-fg">{SITE.now.text}</span>
              <Icon name="arrow-right" size={13} class="transition-transform duration-300 group-hover:translate-x-0.5" />
            </a>
          ) : (
            <span />
          )
        }
        <p class="fig-caption" aria-hidden="true">fig. 1 · gradient descent on a live loss surface<span class="hint"> · move your cursor</span></p>
      </div>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="container-page pt-12 pb-16" aria-label="Featured projects">
        <SectionHeader index="01" label="Selected work" title="Featured *projects*" href="/projects/" linkLabel="All projects" />
        <div class="grid gap-4 md:grid-cols-2">
          {projects.map((project, i) => (
            <ProjectCard project={project} index={i} />
          ))}
        </div>
      </section>
    )
  }

  <section class="container-page py-16" aria-label="Latest writing">
    <SectionHeader index="02" label="Writing" title="Latest *notes*" href="/blog/" linkLabel="All posts" />
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="text-fg-muted">No posts yet.</p>}
  </section>
</BaseLayout>

<style>
  .word-mask {
    display: inline-block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
    vertical-align: top;
  }
  .word {
    display: inline-block;
  }
  .now {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .now-label {
    padding: 0.1rem 0.45rem;
    border: 1px solid oklch(from var(--accent) l c h / 0.4);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .fig-caption {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--fg-subtle);
  }
  @media (width >= 48rem) {
    .fig-caption {
      display: block;
    }
  }
  @media (hover: none) {
    .hint {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .word {
      animation: word-up 800ms var(--ease-out) both;
      animation-delay: calc(200ms + var(--w) * 60ms);
    }
    .hero-in {
      animation: fade-up 700ms var(--ease-out) both;
      animation-delay: calc(var(--d) * 100ms);
    }
    .fig-caption {
      animation: fade-in 1s var(--ease-out) 1.6s both;
    }
    .ping {
      animation: ping 2s var(--ease-out) infinite;
    }
  }
  @keyframes word-up {
    from {
      transform: translateY(110%);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  @keyframes ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
</style>
