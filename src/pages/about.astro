---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Emph from '@/components/Emph.astro';
import Icon from '@/components/Icon.astro';
import { ABOUT, SITE, SOCIALS } from '@/config';
---

<BaseLayout title="About" description={`About ${SITE.name}: education, skills and how to get in touch.`}>
  <section class="container-page pt-14 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-20">
      <div>
        <p class="eyebrow" data-decode>About</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tighter sm:text-6xl" data-reveal style="--i: 1">
          Hi, I'm <Emph text={`*${SITE.name.split(' ')[0]}*`} />.
        </h1>
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-fg-muted" data-reveal style="--i: 2">
          {ABOUT.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--i: 3">
          <a href={SITE.cv} class="btn btn-primary" download>
            <Icon name="download" size={16} /> Download CV
          </a>
          <a href={`mailto:${SITE.email}`} class="btn btn-ghost">
            <Icon name="mail" size={16} /> Get in touch
          </a>
        </div>
      </div>

      <aside class="space-y-3 self-start text-sm" data-reveal style="--i: 3">
        <div class="rounded-2xl border border-border bg-surface p-5">
          <p class="flex items-center gap-2 text-fg-muted"><Icon name="map-pin" size={16} /> {SITE.location}</p>
          <ul class="mt-4 space-y-2.5 border-t border-border pt-4">
            {
              SOCIALS.map(({ label, href, icon }) => (
                <li>
                  <a href={href} class="group flex items-center gap-2 text-fg-muted hover:text-fg" target={href.startsWith('http') ? '_blank' : undefined} rel="me noopener">
                    <Icon name={icon} size={16} />
                    <span class="link-underline">{label === 'Email' ? SITE.email : label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="container-page mt-24" aria-labelledby="education">
    <h2 id="education" class="text-2xl font-semibold" data-reveal>Education</h2>
    <ol class="mt-8 grid gap-4 md:grid-cols-2">
      {
        ABOUT.education.map((item, i) => (
          <li class="rounded-2xl border border-border bg-surface p-6" data-reveal style={`--i: ${i}`}>
            <div class="flex items-start gap-4">
              <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent">
                <Icon name="graduation" size={20} />
              </span>
              <div>
                <h3 class="font-semibold">{item.degree}</h3>
                <p class="mt-1 text-fg-muted">{item.school}</p>
                <p class="mt-2 font-mono text-xs text-fg-subtle">
                  {item.period} · {item.location}
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container-page mt-24" aria-labelledby="skills">
    <h2 id="skills" class="text-2xl font-semibold" data-reveal>Skills</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        ABOUT.skills.map((group, i) => (
          <div class="rounded-2xl border border-border bg-surface p-6" data-reveal style={`--i: ${i}`}>
            <h3 class="eyebrow">{group.area}</h3>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {group.items.map((skill) => (
                <li class="tag">{skill}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
