---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import Callout from '@/components/Callout.astro';
import { getPosts, getRelatedPosts } from '@/lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => {
    // `posts` is newest-first.
    const next = posts[i - 1];
    const prev = posts[i + 1];
    // Prev/next already have cards at the end of the post; don't list them twice.
    const others = posts.filter((p) => p !== next && p !== prev);
    return { params: { slug: post.id }, props: { post, next, prev, related: getRelatedPosts(post, others) } };
  });
}) satisfies GetStaticPaths;

const { post, prev, next, related } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
---

<PostLayout
  post={post}
  headings={headings}
  hasMath={Boolean(remarkPluginFrontmatter.hasMath)}
  prev={prev}
  next={next}
  related={related}
>
  <Content components={{ Callout }} />
</PostLayout>
