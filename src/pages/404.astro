---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroField from '@/components/HeroField.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="relative isolate">
    <HeroField />
    <div class="container-page flex min-h-[70vh] flex-col items-start justify-center py-24">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-3 text-5xl font-semibold tracking-[-0.02em] sm:text-7xl">
        <span class="serif text-gradient">Lost</span> in the latent space.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-fg-muted">
        This page doesn't exist, or it moved somewhere else. The blog and the home page are still here.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">
          <Icon name="arrow-left" size={16} /> Back home
        </a>
        <a href="/blog/" class="btn btn-ghost">Read the blog</a>
      </div>
    </div>
  </section>
</BaseLayout>
