---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  minutes: number;
}

const { headings, minutes } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnote-label');
---

{
  items.length > 1 && (
    <details class="toc-mobile rounded-xl border border-border bg-bg-subtle lg:hidden">
      <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium">
        On this page
        <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <ol class="space-y-2 border-t border-border px-4 py-3 text-sm">
        {items.map((h) => (
          <li class:list={{ 'pl-4': h.depth === 3 }}>
            <a href={`#${h.slug}`} class="text-fg-muted hover:text-fg">
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  )
}

<nav class="toc hidden lg:block" aria-label="Table of contents" data-toc data-minutes={minutes}>
  {
    items.length > 1 && (
      <>
        <p class="eyebrow mb-4 text-fg-subtle!">Contents</p>
        <div class="relative">
          <span class="rail" aria-hidden="true">
            <span class="rail-fill" data-toc-progress />
          </span>
          <ol class="space-y-0.5 text-[0.8125rem]">
            {items.map((h) => (
              <li>
                <a href={`#${h.slug}`} data-toc-link={h.slug} class:list={['toc-link block py-1 leading-snug', h.depth === 3 ? 'pl-7' : 'pl-4']}>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </div>
      </>
    )
  }
  <div class="mt-6 flex items-center justify-between gap-3 border-t border-border pt-4 font-mono text-[0.6875rem] text-fg-subtle">
    <span data-toc-left>{minutes} min read</span>
    <a href="#top" class="hover:text-fg" data-back-to-top>Top ↑</a>
  </div>
</nav>

<style>
  .toc-mobile summary {
    list-style: none;
  }
  .toc-mobile summary::-webkit-details-marker {
    display: none;
  }
  .chevron {
    transition: transform 250ms var(--ease-out);
  }
  .toc-mobile[open] .chevron {
    transform: rotate(180deg);
  }
  .rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    overflow: hidden;
    background: var(--border);
  }
  .rail-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--accent), var(--accent-2));
    transform: scaleY(0);
    transform-origin: top;
  }
  .toc-link {
    position: relative;
    color: var(--fg-subtle);
    transition: color 200ms var(--ease-out);
  }
  .toc-link:hover,
  .toc-link[aria-current='true'] {
    color: var(--fg);
  }
  .toc-link::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--bg);
    transform: translateY(-50%) scale(0);
    transition: transform 250ms var(--ease-out);
  }
  .toc-link[aria-current='true']::before {
    transform: translateY(-50%) scale(1);
  }
</style>
