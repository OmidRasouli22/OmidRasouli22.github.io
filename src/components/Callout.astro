---
import type { IconName } from '@/config';
import Icon from './Icon.astro';

interface Props {
  type?: 'note' | 'tip' | 'warning' | 'danger';
  title?: string;
}

const VARIANTS: Record<NonNullable<Props['type']>, { icon: IconName; label: string }> = {
  note: { icon: 'info', label: 'Note' },
  tip: { icon: 'lightbulb', label: 'Tip' },
  warning: { icon: 'alert', label: 'Warning' },
  danger: { icon: 'alert', label: 'Caution' },
};

const { type = 'note', title } = Astro.props;
const { icon, label } = VARIANTS[type];
---

<aside class:list={['callout', `callout-${type}`]} aria-label={title ?? label}>
  <p class="callout-title">
    <Icon name={icon} size={17} />
    <span>{title ?? label}</span>
  </p>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    --c: var(--note);
    margin-block: 1.75em;
    padding: 1rem 1.25rem;
    border: 1px solid oklch(from var(--c) l c h / 0.3);
    border-left-width: 3px;
    border-radius: 0.625rem;
    background: oklch(from var(--c) l c h / 0.07);
  }
  .callout-tip {
    --c: var(--tip);
  }
  .callout-warning {
    --c: var(--warning);
  }
  .callout-danger {
    --c: var(--danger);
  }
  .callout-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.375rem !important;
    color: var(--c);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .callout-body :global(> :first-child) {
    margin-top: 0;
  }
  .callout-body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
