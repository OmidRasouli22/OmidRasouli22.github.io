---
import Icon from './Icon.astro';
---

<button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Toggle colour theme">
  <span class="theme-icon sun"><Icon name="sun" /></span>
  <span class="theme-icon moon"><Icon name="moon" /></span>
</button>

<style>
  .theme-toggle {
    position: relative;
    overflow: hidden;
  }
  .theme-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition:
      transform 450ms var(--ease-out),
      opacity 300ms var(--ease-out);
  }
  /* Dark theme shows the sun (switch to light) and vice-versa. */
  :global([data-theme='dark']) .moon,
  :global([data-theme='light']) .sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }
</style>

<script>
  function setTheme(theme: 'light' | 'dark') {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {
      /* private mode: the choice just won't persist */
    }
  }

  // Delegated so it keeps working after client-side navigations.
  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest('[data-theme-toggle]');
    if (!button) return;

    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reduceMotion) {
      setTheme(next);
      return;
    }

    // Circular reveal centred on the button.
    const rect = button.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const root = document.documentElement;
    root.style.setProperty('--tx', `${x}px`);
    root.style.setProperty('--ty', `${y}px`);
    root.style.setProperty('--tr', `${radius}px`);
    root.classList.add('theme-switching');

    const transition = document.startViewTransition(() => setTheme(next));
    transition.finished.finally(() => root.classList.remove('theme-switching'));
  });
</script>
