---
import { Image } from 'astro:assets';
import ContourArt from './ContourArt.astro';
import Emph from './Emph.astro';
import Icon from './Icon.astro';
import { formatDate, postUrl, readingTime, type Post } from '@/lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { displayTitle, description, pubDate, tags, cover, draft } = post.data;
---

<div data-reveal>
  <article class="card featured">
    <div class="card-glow" aria-hidden="true"></div>
    <div class="card-inner grid overflow-hidden md:grid-cols-[1.15fr_1fr]">
      <div class="visual" transition:name={`post-visual-${post.id}`}>
        {cover ? <Image src={cover} alt="" widths={[640, 960]} sizes="(min-width: 768px) 40rem, 100vw" class="size-full object-cover" /> : <ContourArt seed={post.id} />}
      </div>
      <div class="flex flex-col p-6 sm:p-8">
        <p class="flex flex-wrap items-center gap-x-2 font-mono text-xs text-accent uppercase tracking-wider">
          <span>Latest</span>
          {tags.slice(0, 2).map((tag) => <span class="text-fg-subtle">· {tag}</span>)}
          {draft && <span class="rounded-full bg-accent-soft px-2 py-0.5 normal-case">Draft</span>}
        </p>
        <h2 class="mt-4 w-fit text-2xl leading-tight font-semibold tracking-tight sm:text-3xl" transition:name={`post-title-${post.id}`}>
          <a href={postUrl(post)} class="stretched-link"><Emph text={displayTitle} /></a>
        </h2>
        <p class="mt-3 leading-relaxed text-fg-muted">{description}</p>
        <p class="mt-auto flex items-center justify-between gap-4 pt-6 font-mono text-xs text-fg-subtle">
          <span>
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · {readingTime(post.body)} min read
          </span>
          <span class="read inline-flex items-center gap-1.5 text-fg">
            Read <Icon name="arrow-right" size={14} />
          </span>
        </p>
      </div>
    </div>
  </article>
</div>

<style>
  .visual {
    min-height: 13rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
  }
  @media (width >= 48rem) {
    .visual {
      min-height: 19rem;
      border-bottom: 0;
      border-right: 1px solid var(--border);
    }
  }
  .read :global(svg) {
    transition: transform 300ms var(--ease-out);
  }
  .featured:hover .read :global(svg) {
    transform: translateX(3px);
  }
</style>
