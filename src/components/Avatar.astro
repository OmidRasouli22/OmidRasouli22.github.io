---
import { Image } from 'astro:assets';
import { SITE } from '@/config';
import { photo } from '@/lib/photo';

interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className } = Astro.props;
---

{
  photo ? (
    <Image src={photo} alt={SITE.name} width={size * 2} height={size * 2} class:list={['avatar', className]} style={`--s: ${size}px`} />
  ) : (
    <span class:list={['avatar monogram', className]} style={`--s: ${size}px`} aria-hidden="true">
      OR
    </span>
  )
}

<style>
  .avatar {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    object-fit: cover;
  }
  .monogram {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-size: calc(var(--s) * 0.32);
    font-weight: 600;
    box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.25);
  }
</style>
