---
import { ABOUT } from '@/config';

// Oldest first, so the path "descends" towards the present.
const steps = [...ABOUT.education].reverse();
const last = steps.length - 1;
---

<figure class="path" style={`--n: ${steps.length}`}>
  <svg class="curve" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0.5 5.5 C 30 5.5, 55 34, 99.5 34" vector-effect="non-scaling-stroke" />
  </svg>
  <ol class="steps">
    {
      steps.map((step, i) => (
        <li class="step" style={`--i: ${i}`} data-reveal>
          <span class:list={['node', { now: i === last }]} aria-hidden="true" />
          <p class="period">{step.period || (i === last ? 'now' : '')}</p>
          <h3 class="mt-2 font-semibold">{step.degree}</h3>
          <p class="mt-1 text-fg-muted">{step.school}</p>
          <p class="mt-1 font-mono text-xs text-fg-subtle">{step.location}</p>
        </li>
      ))
    }
  </ol>
  <figcaption class="caption">fig. 2 · the descent so far</figcaption>
</figure>

<style>
  .path {
    position: relative;
    margin-top: 2rem;
  }
  .curve {
    display: none;
  }
  .steps {
    position: relative;
    display: grid;
    gap: 2rem;
    padding-left: 1.75rem;
    border-left: 1px dashed var(--border-strong);
  }
  .step {
    position: relative;
  }
  .node {
    position: absolute;
    top: 0.3rem;
    left: calc(-1.75rem - 5px);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--fg-subtle);
    box-shadow: 0 0 0 4px var(--bg);
  }
  .node.now {
    background: var(--fg);
    box-shadow:
      0 0 0 4px var(--bg),
      0 0 0 5px var(--accent);
  }
  .period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .caption {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-subtle);
  }

  /* Wide screens: a horizontal descent, each step a little lower than the one before. */
  @media (width >= 48rem) {
    .curve {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 7.5rem;
      overflow: visible;
    }
    .curve path {
      fill: none;
      stroke: var(--fg-subtle);
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-dasharray: 0 7;
    }
    .steps {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: 3rem;
      padding-left: 0;
      border-left: 0;
    }
    .step {
      padding-top: calc(2.1rem + var(--i) / max(var(--n) - 1, 1) * 5.4rem);
    }
    .step:last-child {
      text-align: right;
    }
    .node {
      top: calc(var(--i) / max(var(--n) - 1, 1) * 5.4rem + 0.6rem);
      left: 0;
      width: 11px;
      height: 11px;
    }
    .step:last-child .node {
      left: auto;
      right: 0;
    }
    .node.now::after {
      content: '';
      position: absolute;
      inset: -9px;
      border: 1px solid var(--accent);
      border-radius: 50%;
      opacity: 0.6;
    }
  }
  @media (width >= 48rem) and (prefers-reduced-motion: no-preference) {
    .node.now::after {
      animation: ring 2.4s var(--ease-out) infinite;
    }
  }
  @keyframes ring {
    70%,
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }
</style>
