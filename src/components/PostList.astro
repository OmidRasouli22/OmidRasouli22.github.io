---
import Icon from './Icon.astro';
import { formatDate, postUrl, readingTime, type Post } from '@/lib/posts';

interface Props {
  posts: Post[];
  as?: 'h2' | 'h3';
}

const { posts, as: Heading = 'h3' } = Astro.props;
---

<ul class="post-list" data-hover-list>
  <li class="highlight" aria-hidden="true" data-highlight></li>
  {
    posts.map((post, i) => (
      <li data-reveal style={`--i: ${i}`}>
        <a href={postUrl(post)} class="post-row group" data-row>
          <time datetime={post.data.pubDate.toISOString()} class="date">
            {formatDate(post.data.pubDate)}
          </time>
          <div class="min-w-0 flex-1">
            <Heading class="title w-fit" transition:name={`post-title-${post.id}`}>
              {post.data.title}
            </Heading>
            <p class="desc">{post.data.description}</p>
            {post.data.draft && <span class="mt-2 inline-block rounded-full bg-accent-soft px-2 py-0.5 font-mono text-xs text-accent">Draft</span>}
          </div>
          <span class="meta">
            {readingTime(post.body)} min
            <Icon name="arrow-up-right" size={16} class="arrow" />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    position: relative;
    border-top: 1px solid var(--border);
  }
  .post-list > li:not(.highlight) {
    border-bottom: 1px solid var(--border);
  }
  .highlight {
    position: absolute;
    left: -1rem;
    right: -1rem;
    top: 0;
    border-radius: 0.875rem;
    background: var(--surface-2);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 350ms var(--ease-out),
      height 350ms var(--ease-out),
      opacity 250ms var(--ease-out);
  }
  .post-row {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: 1.5rem;
  }
  .date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-subtle);
    padding-top: 0.3rem;
  }
  .title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  .desc {
    margin-top: 0.375rem;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    display: none;
  }
  @media (width >= 40rem) {
    .post-row {
      flex-direction: row;
      gap: 2rem;
      padding-block: 1.75rem;
    }
    .date {
      width: 7.5rem;
      flex-shrink: 0;
    }
    .desc {
      -webkit-line-clamp: 1;
    }
    .meta {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      flex-shrink: 0;
      padding-top: 0.2rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--fg-subtle);
    }
  }
  .meta :global(.arrow) {
    color: var(--fg-muted);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition:
      opacity 250ms var(--ease-out),
      transform 250ms var(--ease-out);
  }
  .post-row:hover :global(.arrow),
  .post-row:focus-visible :global(.arrow) {
    opacity: 1;
    transform: none;
  }
  .post-row:hover .title {
    color: var(--fg);
  }
</style>

<script>
  // One highlight per list that glides to whichever row is hovered.
  document.addEventListener('pointerover', (event) => {
    if ((event as PointerEvent).pointerType !== 'mouse') return;
    const row = (event.target as Element | null)?.closest<HTMLElement>('[data-row]');
    const list = row?.closest<HTMLElement>('[data-hover-list]');
    const highlight = list?.querySelector<HTMLElement>('[data-highlight]');
    if (!row || !list || !highlight) return;
    const item = row.parentElement!;
    const hidden = highlight.style.opacity !== '1';
    if (hidden) highlight.style.transition = 'opacity 250ms';
    highlight.style.transform = `translateY(${item.offsetTop}px)`;
    highlight.style.height = `${item.offsetHeight}px`;
    highlight.style.opacity = '1';
    if (hidden) requestAnimationFrame(() => highlight.style.removeProperty('transition'));
  });

  document.addEventListener('pointerout', (event) => {
    const list = (event.target as Element | null)?.closest<HTMLElement>('[data-hover-list]');
    const next = (event as PointerEvent).relatedTarget as Element | null;
    if (list && !list.contains(next)) {
      const highlight = list.querySelector<HTMLElement>('[data-highlight]');
      if (highlight) highlight.style.opacity = '0';
    }
  });
</script>
