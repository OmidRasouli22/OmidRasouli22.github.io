---
import { Image } from 'astro:assets';
import { formatDate, postUrl, readingTime, type Post } from '@/lib/posts';

interface Props {
  post: Post;
  /** Position in the list, used to stagger the reveal animation. */
  index?: number;
  as?: 'h2' | 'h3';
}

const { post, index = 0, as: Heading = 'h3' } = Astro.props;
const { title, description, pubDate, tags, cover, coverAlt, draft } = post.data;
---

<div data-reveal style={`--i: ${index}`} class="h-full">
  <article class="card h-full">
    <div class="card-glow" aria-hidden="true"></div>
    <div class="card-inner flex flex-col">
      {
        cover && (
          <div class="overflow-hidden rounded-t-[calc(var(--radius)-1px)] border-b border-border" transition:name={`post-cover-${post.id}`}>
            <Image
              src={cover}
              alt={coverAlt ?? ''}
              widths={[480, 800]}
              sizes="(min-width: 768px) 400px, 100vw"
              class="aspect-[16/9] w-full object-cover"
            />
          </div>
        )
      }
      <div class="flex flex-1 flex-col p-5 sm:p-6">
        <p class="flex flex-wrap items-center gap-x-2 font-mono text-xs text-fg-subtle">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body)} min read</span>
          {draft && <span class="rounded-full bg-accent-soft px-2 py-0.5 text-accent">Draft</span>}
        </p>
        <Heading class="mt-3 w-fit text-lg leading-snug font-semibold tracking-tight" transition:name={`post-title-${post.id}`}>
          <a href={postUrl(post)} class="stretched-link">{title}</a>
        </Heading>
        <p class="mt-2 line-clamp-3 text-[0.9375rem] leading-relaxed text-fg-muted">{description}</p>
        {
          tags.length > 0 && (
            <ul class="mt-auto flex flex-wrap gap-1.5 pt-5" aria-label="Tags">
              {tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </article>
</div>
