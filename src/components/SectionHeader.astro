---
import Emph from './Emph.astro';
import Icon from './Icon.astro';

interface Props {
  index: string;
  label: string;
  /** Use *word* for the serif emphasis. */
  title: string;
  href?: string;
  linkLabel?: string;
}

const { index, label, title, href, linkLabel = 'View all' } = Astro.props;
---

<div class="mb-10" data-reveal>
  <div class="flex items-center gap-4">
    <p class="eyebrow shrink-0" data-decode>{index} / {label}</p>
    <span class="rule" aria-hidden="true"></span>
    {
      href && (
        <a href={href} class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-fg-muted hover:text-fg">
          <span class="link-underline">{linkLabel}</span>
          <Icon name="arrow-right" size={16} class="transition-transform duration-300 group-hover:translate-x-0.5" />
        </a>
      )
    }
  </div>
  <h2 class="mt-5 text-3xl font-semibold sm:text-4xl"><Emph text={title} /></h2>
</div>
